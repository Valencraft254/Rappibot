let comando = "";

function actualizarVista() {

    const title = document.getElementById("title").value;
    const description = document.getElementById("description").value;
    const color = document.getElementById("color").value;
    const thumbnail = document.getElementById("thumbnail").value;
    const image = document.getElementById("image").value;
    const footer = document.getElementById("footer").value;


    document.getElementById("pTitle").innerText =
        title || "Título del embed";


    document.getElementById("pDescription").innerText =
        description || "Descripción del embed";


    document.getElementById("pFooter").innerText =
        footer || "Footer";


    document.getElementById("embed").style.borderColor = color;


    const img = document.getElementById("pImage");

    if (image) {
        img.src = image;
        img.style.display = "block";
    } else {
        img.style.display = "none";
    }


    const thumb = document.getElementById("pThumbnail");

    if (thumbnail) {
        thumb.src = thumbnail;
        thumb.style.display = "block";
    } else {
        thumb.style.display = "none";
    }

}


// Actualizar vista en tiempo real
document.querySelectorAll("input, textarea")
.forEach(element => {
    element.addEventListener("input", actualizarVista);
});



function generar() {

    const embed = {

        title: document.getElementById("title").value,

        description:
            document.getElementById("description").value,

        color:
            document.getElementById("color").value,

        thumbnail:
            document.getElementById("thumbnail").value,

        image:
            document.getElementById("image").value,

        footer:
            document.getElementById("footer").value

    };


    // Convertir JSON a código
    const codigo = btoa(
        JSON.stringify(embed)
    );


    comando = "$embed " + codigo;


    document.getElementById("codigo").innerText =
        comando;

}



function copiar() {

    if (!comando) {
        alert("Primero genera el código");
        return;
    }


    navigator.clipboard.writeText(comando);

    alert("✅ Comando copiado");

}


// Cargar vista inicial
actualizarVista();